# Django Settings
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Django Secret Key (generate a new one for production!)
DJANGO_SECRET_KEY=django-insecure-w#gl*eh2u-&xaei3^&z1=0h90ij72hzwi3vcndcd)54(b(nj!t

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated list for production)
ALLOWED_HOSTS=localhost,127.0.0.1

# Spoonacular API Key (get from https://spoonacular.com/food-api)
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# OpenAI API Key (for frontend receipt scanning - also needs to be in frontend/.env.local as VITE_OPENAI_API_KEY)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Email Configuration (optional - for production)
# For development, emails are printed to console by default
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=noreply@yumyumapp.com
